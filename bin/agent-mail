# agent-mail v1 lancé depuis le dépôt, sans rien installer dans ~/.local/bin.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${AMEESH_PYTHON:-${AGENT_MESH_PYTHON:-python3}}" -m ameesh.cli "$@"
