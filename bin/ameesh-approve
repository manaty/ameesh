#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# ameesh-approve : le service d'approbation depuis le dépôt (sous l'utilisateur du service).
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${AMEESH_PYTHON:-python3}" -m ameesh.approve "$@"
