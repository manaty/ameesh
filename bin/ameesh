#!/usr/bin/env bash
# ameesh : la commande du mesh depuis le dépôt (agent-mail/agent-runner restent des alias).
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${AGENT_MESH_PYTHON:-python3}" -m agent_mesh.mesh_cli "$@"
