[Unit]
Description=One privileged typed handoff request (H8)

[Service]
Type=exec
User=root
Group=root
ExecStart=/opt/ameesh-release/runtime/bin/python -I -B /opt/ameesh-release/lib/dispatch-local-handoff.py
StandardInput=socket
StandardOutput=null
StandardError=journal
Environment=PATH=/usr/bin:/bin LANG=C LC_ALL=C
WorkingDirectory=/
UMask=0077
RuntimeMaxSec=65
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
