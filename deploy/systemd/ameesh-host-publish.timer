# #2022 — publishes this host's reading every minute (host without a runner).
# Install: cp ameesh-host-publish.{service,timer} ~/.config/systemd/user/ &&
#          systemctl --user enable --now ameesh-host-publish.timer
[Unit]
Description=ameesh host reading every minute (#2022)

[Timer]
# Keep gaps below the 180s lifecycle proof window, including timer coalescing.
AccuracySec=1s
OnActiveSec=1min
OnUnitActiveSec=60s
RandomizedDelaySec=10s
Persistent=true

[Install]
WantedBy=timers.target
