# generated by `ameesh role timers` — do not edit; rerun the command
# On every candidate of the mesh-design role; only the lease holder dispatches.
# #7483: UTC guard in workflow and each psql part.
[Unit]
Description=ameesh — daily psql dispatch in its window (#7483)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/ameesh/env
EnvironmentFile=-%h/.config/ameesh/notify.env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh role run mesh-design -- %h/.local/share/ameesh/venv/bin/ameesh psql-nocturne dispatch
TimeoutStartSec=5min
NoNewPrivileges=yes
