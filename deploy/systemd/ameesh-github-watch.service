#
# #8059 — veille GitHub AU REPOS, sans agent ni LLM. Unité SYSTÈME, installée
# par le bureau avec root sur l'hôte toujours allumé qui porte le worker de
# l'adaptateur VM (BG, bureau-goal), selon le même modèle que ce worker :
# même compte opérateur, même database.env, même venv.
# Elle ne passe PAS par `ameesh role run` : aucune élection, aucun bail. Le
# passage s'efface de lui-même tant que le rôle élu de la veille
# (mesh-design, réglable par `github.watch_role`) a un bail vivant : sous
# activité, c'est la minuterie du rôle qui collecte.
#
# Autorisation : `github.host` doit nommer cet hôte dans la configuration lue
# par `AMEESH_CONFIG` (database.env). Les dépôts surveillés viennent des
# cartes `github_watch` du canon.
#
# Jeton GitHub : `GH_TOKEN` en lecture seule dans
# /etc/ameesh-github-watch/notify.env, root:root 0600. systemd lit ce fichier
# avant de passer au compte du service : le compte opérateur ne peut pas le
# lire sur disque. Le code lit `GH_TOKEN`/`GITHUB_TOKEN` et ne lit pas
# `$CREDENTIALS_DIRECTORY`, d'où ce choix plutôt que `LoadCredential`.
#
# Installation (root, sur BG) :
#   install -m 0644 deploy/systemd/ameesh-github-watch.service \
#                      deploy/systemd/ameesh-github-watch.timer \
#                      /etc/systemd/system/
#   # remplacer User= par le compte opérateur existant (celui du worker)
#   systemctl daemon-reload
#   # poser /etc/ameesh-github-watch/notify.env (root:root 0600, GH_TOKEN=…)
#   systemctl enable --now ameesh-github-watch.timer
#   journalctl -u ameesh-github-watch -f
# Retour arrière : systemctl disable --now ameesh-github-watch.timer, retirer
# les deux unités, systemctl daemon-reload. Le curseur en base reste.
[Unit]
Description=ameesh GitHub watch at rest (standby collector, #8059)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Le compte opérateur existant du worker : jamais un compte d'agent.
User=REPLACE_WITH_EXISTING_OPERATOR_ACCOUNT
UMask=0077
# La connexion mesh de l'opérateur (AMEESH_CONFIG), le même fichier que le
# worker : aucun droit SQL nouveau, aucun élargissement de bureau_goal.
EnvironmentFile=/etc/ameesh-vm-adapter/database.env
# GH_TOKEN en lecture seule, root:root 0600 (voir l'en-tête).
EnvironmentFile=/etc/ameesh-github-watch/notify.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ameesh-vm-adapter/venv/bin/python -m ameesh notify --once --only github-watch
TimeoutStartSec=5min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
# Pas de ProtectHome=read-only : `ameesh notify` écrit son cache et son état
# sous le répertoire du compte. Le jeton, lui, n'est pas sur son disque.
ProtectSystem=full
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
