# SPDX-License-Identifier: AGPL-3.0-only
# Install on EVERY configured candidate; execution follows the shared role
# and execution leases, not this host's timer. No agent turn is the launcher.
# #5494: nothing here names an account. The unit runs under the user manager
# of whichever account holds the deployment access (the runner account, or a
# dedicated one); %h is that account's home. It needs, in that home: the
# database environment (.config/ameesh/env), the private configuration
# (.config/ameesh/staging-executor.json) and its OWN stable venv
# (.local/share/ameesh/venv, bascule.py layout). vm.sh only switches the venv
# of the runner account: a dedicated account must never run that venv (agent
# turns can write it) and keeps its own, updated by its own step (see
# docs/DEPLOIEMENT-HOTE-AGENTS.md, "venv de l'executant").
[Unit]
Description=ameesh elected staging executor (#4880)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Slice=app.slice
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/ameesh/env
ExecStart=%h/.local/share/ameesh/venv/bin/python3 -m ameesh.staging_executor --config %h/.config/ameesh/staging-executor.json tick
# #5450: the global staging fallback is 11 h and its monitored stop starts
# 15 min later; the unit must still leave room for the rollback and settling.
# 11h30min stays below the 12 h between two cutoffs.
TimeoutStartSec=11h30min
# #5450: let the launcher TERM trap finish the current host rollback.
TimeoutStopSec=5min
KillMode=control-group
# #5663: files the sequence writes (kept trees, venv, marks) stay readable by
# the other accounts that deploy or inspect them; secrets are written 0600.
UMask=0022
# NoNewPrivileges is deliberately absent until the real qualification (#5484
# Q0-Q5) proves it harmless. vm.sh calls no local sudo: a candidate deploys
# itself over the SSH identity of its BASCULE_ENV (root@ its own address).
# Credential placement is a separate operator action.
