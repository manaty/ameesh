# SPDX-License-Identifier: AGPL-3.0-only
# #3845 — un tic toutes les dix minutes ; le script compose au plus un porteur
# par heure, mais un porteur fusionné (#4171), ou abandonné/remplacé sans CI
# active (#5786), libère le créneau : deux porteurs peuvent naître dans la
# même heure. Il suit sinon le porteur ouvert (ci-full, rouge, recomposition).
# #4361 : ne pas arrêter cette minuterie pour suspendre le tic (le contrôle
# `role timers --check` échouerait) : `paquet-horaire.py pause --until …`.
[Unit]
Description=ameesh paquet horaire, tic (#3845)

[Timer]
OnCalendar=*:0/10
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
