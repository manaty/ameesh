# SPDX-License-Identifier: AGPL-3.0-only
#
# ameesh — exécuteur d'UN agent, service UTILISATEUR (modèle : %i = l'agent).
# Une instance par agent mené sur l'hôte, y compris un agent tenu en
# `ameesh attach` : si la session interactive meurt (coupure, terminal tué),
# c'est cette unité qui reprend la même session (L106).
#
# Installation :
#   install -m 0644 'deploy/systemd/ameesh-runner-agent@.service' \
#     deploy/systemd/ameesh-agents.slice ~/.config/systemd/user/
#   install -D -m 0644 'deploy/systemd/ameesh-runner-agent@.service.d/cargo-target.conf' \
#     ~/.config/systemd/user/ameesh-runner-agent@.service.d/cargo-target.conf   # #248
#   systemctl --user daemon-reload
#   systemctl --user enable --now ameesh-runner-agent@<agent>
#   journalctl --user -u ameesh-runner-agent@<agent> -f
#   ameesh doctor --harness        # binaires résolus, unités manquantes
#
# PATH (L106) : une unité utilisateur peut démarrer AVANT que la session
# n'importe son PATH dans le gestionnaire systemd (2026-10-10 : `claude`
# introuvable, `node` absent pour dsh, au redémarrage après une coupure). Le
# PATH est donc posé ici, explicitement : shims mise, ~/.local/bin, système.
# Un hôte qui installe ses harnais ailleurs le complète dans
# ~/.config/ameesh/env (PATH=… en entier : systemd n'y développe pas $PATH),
# ou nomme ses binaires (`harness_bins` de config.json, AMEESH_<HARNAIS>_BIN).
# L'exécuteur cherche de toute façon, après le PATH : le PATH du gestionnaire
# systemd (relu à chaque essai), puis les emplacements connus (installations
# mise, ~/.local/bin, cache npx) — et journalise le chemin absolu retenu.

[Unit]
Description=ameesh — exécuteur de l'agent %i
After=network-online.target
Wants=network-online.target

[Service]
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
# AMEESH_DSN, AMEESH_HOST, AMEESH_CANON… ; peut redéfinir PATH (facultatif)
EnvironmentFile=-%h/.config/ameesh/env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh run --agents %i --runner-id runner-%i@%H
# Une base pas encore là au démarrage n'est plus une sortie en échec (L106,
# attente croissante) ; une sortie anormale relance l'exécuteur.
Restart=on-failure
RestartSec=30
# Arrêt et redémarrage (2026-10-11) : le SIGTERM va au SEUL exécuteur
# (KillMode=mixed), qui DRAINE — plus de nouveau tour ; le tour en cours et
# son travail de fond finissent, dans la borne AMEESH_DRAIN_SECONDS (30 min
# par défaut) ; au-delà, tour arrêté et consigne remise en attente. Puis baux
# rendus et sortie ; systemd tue (SIGKILL) ce qui resterait dans le groupe de
# contrôle. Avant, le SIGTERM allait à tout le groupe, harnais compris : un
# `systemctl restart` tuait le tour en cours et son travail.
# `systemctl --user restart` attend donc la fin du tour (au plus la borne).
# Arrêt immédiat : un second SIGTERM à l'exécuteur,
#   kill -TERM "$(systemctl --user show -p MainPID --value ameesh-runner-agent@<agent>)"
# TimeoutStopSec couvre la borne et le nettoyage : le garder au-dessus de
# AMEESH_DRAIN_SECONDS + 5 min.
KillMode=mixed
TimeoutStopSec=35min
NoNewPrivileges=yes
# Plafond mémoire (L159c). 2026-10-10, VM du mesh : le `node` d'un harnais a
# atteint 4,1 Go, et l'OOM du noyau l'a tué ; l'unité n'avait aucun plafond.
# MemoryMax borne l'agent (harnais, tests, travail de fond) : l'OOM ne tue
# que dans son groupe. MemoryHigh, à 90 %, fait reprendre la mémoire avant.
# Défaut 6 Gio ; un hôte ou un agent qui veut autre chose le déclare au canon
# (policy.resources.agent_memory_max, agent_memory_max_by_agent de la fiche
# Host), et `ameesh doctor` donne la commande qui l'applique :
#   systemctl --user set-property ameesh-runner-agent@<agent> MemoryMax=8192M MemoryHigh=7372M
# OOMScoreAdjust : sous une pression globale, l'agent part avant le reste.
Slice=ameesh-agents.slice
MemoryHigh=5.4G
MemoryMax=6G
OOMScoreAdjust=500

[Install]
WantedBy=default.target
