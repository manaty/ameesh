# SPDX-License-Identifier: AGPL-3.0-only
#
# ameesh — slice SYSTÈME des exécuteurs d'agent d'un serveur (VM du mesh,
# L159c). Les personas y tournent sous `ameesh-runner@<p>`, service système
# hors dépôt ; le complément `ameesh-runner@.service.d/10-plafonds.conf` les
# y range. Installation (root, par le propriétaire) : docs/EXPLOITATION.md,
# « Plafonds mémoire des agents ».

[Unit]
Description=ameesh — exécuteurs d'agent (système)
Before=slices.target

[Slice]
MemoryHigh=80%
MemoryMax=85%
