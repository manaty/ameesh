#
# ameesh veille — avance les adoptions de versions (#4293, #3264 C).
# Service UTILISATEUR, sur UN hôte qui a la base (le même que la release ou un
# hôte d'agents) : l'état vit en base et les exécuteurs relisent la ligne de
# leur agent au début de chaque tour. Aucun binaire n'est lancé par ce tick.
#
# Install, on one host only:
#   install -m 0644 deploy/systemd/ameesh-veille.service \
#                      deploy/systemd/ameesh-veille.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ameesh-veille.timer
#   journalctl --user -u ameesh-veille -f
#
# The tick is a no-op while no adoption is open. It refuses to switch a host
# when the next release cutoff is less than 20 minutes away, or while a turn
# of the harness is running on that host (spec §4).
[Unit]
Description=ameesh veille (adoption of harness/model versions, #4293)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/ameesh/env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh veille tick
TimeoutStartSec=30m
NoNewPrivileges=yes
