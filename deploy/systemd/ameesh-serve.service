#
# ameesh serve — l'API de lecture /api/v1 du maillage, mode local (lot L84,
# étude docs/design/etudes/ui-integrable.md §7). Service UTILISATEUR, lié à
# 127.0.0.1 seulement ; un jeton Bearer dans ~/.config/ameesh/serve-token
# (0600, créé au premier démarrage, jamais réécrit). Processus et origine
# distincts d'ameesh-approve.
#
# Installation :
#   install -m 0644 deploy/systemd/ameesh-serve.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ameesh-serve
#   journalctl --user -u ameesh-serve -f
#
# Essai : curl -H "Authorization: Bearer $(cat ~/.config/ameesh/serve-token)" \
#           http://127.0.0.1:8780/api/v1/me
# Voir docs/EXPLOITATION.md, « API de lecture — ameesh serve ».

[Unit]
Description=ameesh serve — API de lecture locale (/api/v1)
After=network-online.target
Wants=network-online.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# AMEESH_DSN, AMEESH_HOST… (le même fichier que l'exécuteur) ; facultatif :
# AMEESH_SERVE_TOKEN_FILE
EnvironmentFile=%h/.config/ameesh/env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh serve --port 8780
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.config/ameesh
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
