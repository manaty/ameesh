# SPDX-License-Identifier: AGPL-3.0-only
# #4293 — one tick every five minutes; the command only advances open
# adoptions (canary measurement, host-by-host switch, rollback on a canary
# regression). `Persistent=true` replays one tick after a reboot; no cutoff is
# missed by a late tick (the rollout guard reads the next cutoff itself).
[Unit]
Description=ameesh harness adoption tick (harness/model versions, #4293)

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
