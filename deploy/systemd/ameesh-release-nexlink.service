# SPDX-License-Identifier: AGPL-3.0-only
# Dedicated Nexlink unit: do not inherit ameesh-release.service drop-ins.
[Unit]
Description=Nexlink release at the compiled canon cutoffs (#3529)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# AMEESH_DSN, AMEESH_HOST, AMEESH_CANON… (the same file as the runner).
EnvironmentFile=%h/.config/ameesh/env
# Optional: GH_TOKEN if `gh` has no session for this service.
EnvironmentFile=-%h/.config/ameesh/release.env
# Load the deployed package, never a stale release checkout from the environment.
UnsetEnvironment=PYTHONPATH
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh release tick --project nexlink
# A full staging sequence is bounded to two hours; the unit must not cut it.
TimeoutStartSec=4h
NoNewPrivileges=yes
