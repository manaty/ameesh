# SPDX-License-Identifier: AGPL-3.0-only
# #2448 — one tick every minute on each elected candidate; the command reads the compiled cutoffs.
# `Persistent=true` replays a tick missed during a reboot; a cutoff older than
# its window is reported as missed, never run late.
[Unit]
Description=ameesh release tick (compiled canon cutoffs, #2448)

[Timer]
OnBootSec=1min
OnUnitActiveSec=60s
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
