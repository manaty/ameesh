# L226a — credential sentinel: probes every credential the agents of this
# host use (Claude, Codex, gcloud, gh, scw) and reports its health to
# `credential_health`; `ameesh notify` pushes `credential_failing` and
# `credential_expiring` to the owner with the exact fix command.
# Started every 10 minutes by ameesh-credentials.timer.
[Unit]
Description=ameesh credential sentinel (L226a)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/ameesh/env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh accounts check
Nice=10
NoNewPrivileges=yes
