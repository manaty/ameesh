#
# ameesh release — tag and staging at the compiled canon cutoffs (#2448).
# Service UTILISATEUR, on the single operator host (pc-smichea): the release
# command reads `release.projects` from ~/.config/ameesh/config.json, refuses
# when it is not this host, and holds the target lease while it works.
#
# Install, on the operator host only:
#   install -m 0644 deploy/systemd/ameesh-release.service \
#                      deploy/systemd/ameesh-release.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ameesh-release.timer
#   journalctl --user -u ameesh-release -f
#
# The timer ticks every five minutes; `ameesh release tick` decides from the
# compiled `mechanics.cutoffs` and does nothing outside a cutoff window.
# #2601: the same tick runs the "missed slot" packet alert when the host file
# declares `packet_watch` (composer and pilot as `notify`).
[Unit]
Description=ameesh release at the compiled canon cutoffs (#2448)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# AMEESH_DSN, AMEESH_HOST, AMEESH_CANON… (the same file as the runner).
EnvironmentFile=%h/.config/ameesh/env
# Optional: GH_TOKEN if `gh` has no session for this service.
EnvironmentFile=-%h/.config/ameesh/release.env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh release tick
# A full staging sequence is bounded to two hours; the unit must not cut it.
TimeoutStartSec=4h
NoNewPrivileges=yes
