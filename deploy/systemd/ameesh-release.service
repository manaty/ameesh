#
# ameesh release — tag and staging at the compiled canon cutoffs (#2448).
# User service on EVERY candidate of release.role (the elected pilot).
# Configure release.role and packet_watch.role identically; remove legacy host
# selectors. The CLI wraps the whole tick in a shared, watched execution lease,
# including packet-watch; standby candidates exit 0 without host operations.
# Use the installed versioned venv, never a command from an abandoned checkout.
# Install service+timer on each candidate; the bureau migrates existing drop-ins.
# The 60 s cadence plus a 180 s role lease permits takeover within five minutes.
[Unit]
Description=ameesh release at the compiled canon cutoffs (#2448)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# AMEESH_DSN, AMEESH_HOST, AMEESH_CANON… (the same file as the runner).
EnvironmentFile=%h/.config/ameesh/env
# Optional: GH_TOKEN if `gh` has no session for this service.
EnvironmentFile=-%h/.config/ameesh/release.env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh release tick
# A full staging sequence is bounded to two hours; the unit must not cut it.
TimeoutStartSec=4h
NoNewPrivileges=yes
