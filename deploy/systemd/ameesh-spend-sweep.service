# generated by `ameesh role timers` — do not edit; rerun the command
# On every candidate of the mesh-design role; only the lease holder dispatches.
# #7865: exits 1 if a stop fails, after escalating it to the grant approver.
[Unit]
Description=ameesh — daily spend sweep before the UTC day rolls (#7865)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/ameesh/env
EnvironmentFile=-%h/.config/ameesh/notify.env
ExecStart=%h/.local/share/ameesh/venv/bin/ameesh role run mesh-design -- %h/.local/share/ameesh/venv/bin/ameesh action spend sweep
TimeoutStartSec=5min
NoNewPrivileges=yes
