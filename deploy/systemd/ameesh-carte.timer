# SPDX-License-Identifier: AGPL-3.0-only
# #7430 — passage horaire : dispatch quotidien à 01:00Z, sinon seulement
# si la carte connue dépasse 48 h. Le workflow garde la priorité des paquets.
# Le cron GitHub reste le filet de secours ; Persistent rattrape un passage.
[Unit]
Description=ameesh impact-map measurement dispatch in its window (#6777)

[Timer]
OnCalendar=*-*-* *:00:00 UTC
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
