# L226a — runs the credential sentinel every 10 minutes.
# #8062: installed and enabled by the host update — user unit on an agent VM
# or the poste (`vm.sh agents installer`, `poste.sh installer`), system unit
# on the server (`installer-serveur.sh`, `vm.sh installer`) with
# deploy/serveur/ameesh-credentials.service. Not copied by hand on a host.
[Unit]
Description=ameesh credential sentinel every 10 minutes (L226a)

[Timer]
OnActiveSec=2min
OnUnitActiveSec=10min
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
