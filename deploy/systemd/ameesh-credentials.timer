# L226a — runs the credential sentinel every 10 minutes.
# Install: cp ameesh-credentials.{service,timer} ~/.config/systemd/user/ &&
#          systemctl --user enable --now ameesh-credentials.timer
[Unit]
Description=ameesh credential sentinel every 10 minutes (L226a)

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
