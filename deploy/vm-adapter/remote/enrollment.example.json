{
  "host": "burst-host",
  "probe_agent": "burst-host-probe",
  "ameesh_config": "/etc/ameesh-vm-adapter/remote-database.json",
  "state_dir": "/var/lib/ameesh-vm-remote",
  "fresh_seconds": 60,
  "reconcile_deadline_s": 900,
  "checks": {
    "version-mode": [
      "/usr/bin/python3",
      "-I",
      "/opt/ameesh-vm-adapter/checks/health.py",
      "version-mode"
    ],
    "doctor": [
      "/usr/bin/python3",
      "-I",
      "/opt/ameesh-vm-adapter/checks/health.py",
      "doctor"
    ]
  },
  "health": {
    "receipt": "/var/lib/ameesh-vm-health/health.json",
    "producer_uid": 1000,
    "period_s": 60,
    "version": "RENDER_INSTALLED_VERSION",
    "sha": "0000000",
    "mode": "execute"
  }
}
