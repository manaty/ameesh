[Unit]
Description=ameesh — sauvegarde de la base du mesh
After=postgresql.service

[Service]
Type=oneshot
User=ameesh
# #1305 : les dumps ne doivent jamais être lisibles par un autre compte, même
# si le script perdait son umask.
UMask=0077
ExecStart=/usr/local/sbin/ameesh-sauvegarder-base
# #5681: dump <=3600, listing <=1800, upload <=1800, retention + margin.
TimeoutStartSec=9000
TimeoutStopSec=30
KillMode=control-group
