#
# #8062 — la sentinelle des identifiants sur le serveur du mesh (L226a), en
# unité SYSTÈME sous l'utilisateur `ameesh` : le serveur mène des personas
# avec /opt/ameesh/venv et /etc/ameesh/harnais.env, pas le layout d'une VM
# d'agents. Même sonde que deploy/systemd/ameesh-credentials.service (unité
# utilisateur sur une VM ou le poste), même minuterie :
# deploy/systemd/ameesh-credentials.timer.
#
# Posée par deploy/serveur/installer-serveur.sh et par la mise à jour
# `deploy/mise-a-jour/vm.sh installer` (serveur), jamais à la main.
[Unit]
Description=ameesh credential sentinel (L226a, server)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ameesh
Group=ameesh
WorkingDirectory=/home/ameesh
Environment=HOME=/home/ameesh
Environment=PATH=/home/ameesh/.local/share/mise/shims:/home/ameesh/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
# les mêmes sources que l'exécuteur du serveur, sans secret dans l'unité
EnvironmentFile=-/home/ameesh/.config/ameesh/env
EnvironmentFile=-/etc/ameesh/harnais.env
ExecStart=/opt/ameesh/venv/bin/ameesh accounts check
Nice=10
NoNewPrivileges=yes
