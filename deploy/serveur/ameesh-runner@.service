#
# Un exécuteur par persona sur le serveur d'un mesh (lot L55). Service SYSTÈME
# sous l'utilisateur `ameesh` ; ajouter une persona ne coupe jamais le tour
# d'une autre.
#
#   systemctl enable --now ameesh-runner@<persona>
#   journalctl -u ameesh-runner@<persona> -f

[Unit]
Description=ameesh — exécuteur de la persona %i
After=network-online.target postgresql.service wg-quick@wg0.service
Wants=network-online.target

[Service]
User=ameesh
Group=ameesh
WorkingDirectory=/home/ameesh
# Clés API de l'organisation (0033 §3) : /etc/ameesh/harnais.env, 0640 root:ameesh.
# PATH posé ici comme pour l'unité du poste (L106) : harnais installés par
# mise ou dans ~/.local/bin de l'utilisateur ameesh.
Environment=PATH=/home/ameesh/.local/share/mise/shims:/home/ameesh/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/ameesh/harnais.env
ExecStart=/opt/ameesh/venv/bin/ameesh run --agents %i --runner-id runner-%i@%H
Restart=on-failure
RestartSec=30
# Arrêt drainé, comme deploy/systemd/ameesh-runner-agent@.service : le SIGTERM
# va au seul exécuteur, qui finit son tour (borne AMEESH_DRAIN_SECONDS, 30 min
# par défaut) avant de sortir ; `systemctl restart` attend donc la fin du tour.
KillMode=mixed
TimeoutStopSec=35min
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
