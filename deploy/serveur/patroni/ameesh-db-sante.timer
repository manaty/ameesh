# SPDX-License-Identifier: AGPL-3.0-only
#
# Minuterie du contrôle de santé (EP8.4b, lot #6870) : toutes les minutes,
# après le démarrage. Une alerte est visible dans le journal du service et
# dans /run/ameesh-db/alertes.json, relayée par le passage local
# d'ameesh notify (EP8.5, #6862) ; un document de plus de 5 min lève
# db_health_stale.
[Unit]
Description=Minuterie du contrôle de santé de la grappe PostgreSQL ameesh

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s
RandomizedDelaySec=5s
Unit=ameesh-db-sante.service

[Install]
WantedBy=timers.target
