#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
#
# #3444 — témoin d'isolation d'un exécuteur d'agent (GARDE-FOU, pas la
# frontière : voir docs/EXPLOITATION.md).
#
# Appelé par le drop-in OPT-IN `deploy/poste/cles-owner.conf` en
# ExecStartPre, donc DANS le mount namespace de l'unité. Il ne juge pas le
# CONTENU du chemin : un `~/.ssh` vide sans isolation passerait, et une clé
# déposée après le démarrage redeviendrait lisible (relecture cx1 #3444 B1).
# Il exige qu'un MONTAGE soit posé SUR le chemin dans le namespace de
# l'unité (`/proc/self/mountinfo`, champ 5) : c'est la preuve directe que
# systemd a appliqué `InaccessiblePaths=` (tmpfs `mode=000` sur le
# répertoire), et le contenu réel est alors hors d'atteinte pour la vie de
# l'unité. Aucun montage = isolation absente = sortie 1, l'unité refuse de
# démarrer.
#
# Posé en root, non modifiable par l'agent qu'il contrôle :
#   install -D -m 0755 deploy/poste/verifie-cles-owner \
#     /usr/local/libexec/ameesh/verifie-cles-owner
#
# Usage : verifie-cles-owner CHEMIN...
set -u

# Un montage sur le chemin ? Chemins résolus (systemd résout aussi les
# liens) ; les échappements octaux de mountinfo ne concernent pas les
# chemins du poste.
est_masque() {
  resolue=$(readlink -f -- "$1" 2>/dev/null) || return 1
  [ -n "$resolue" ] || return 1
  awk -v p="$resolue" '$5 == p { trouve = 1 } END { exit !trouve }' /proc/self/mountinfo
}

statut=0
for chemin in "$@"; do
  if est_masque "$chemin"; then
    continue
  fi
  echo "isolation absente : aucun montage sur $chemin dans l'unité" >&2
  statut=1
done
exit "$statut"
