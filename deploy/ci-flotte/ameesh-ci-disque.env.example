# Root-owned /etc/ameesh-ci-disque.env, mode 0644 (aucun secret).
# Un workspace existant de la VM ; le script en déduit les runners voisins.
RUNNER_WORKSPACE=/home/runner/r1/_work/ameesh
# Optionnel : seuil des annotations GitHub (la surveillance mesh utilise
# séparément les seuils de la fiche Host et resources.disk_warnings).
AMEESH_CI_DISQUE_MIN_GIB=15
# #5751 : si le nom physique déclaré au veilleur diffère de hostname :
# AMEESH_CI_DISQUE_HOST=ci-vm-a
