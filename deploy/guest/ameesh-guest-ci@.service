# SPDX-License-Identifier: AGPL-3.0-only
# One GitHub Actions runner of the ameesh GUEST on a lending host (lot
# #1256): temporary capacity borrowed from an existing CI VM of another
# project, never a runner of the host's own application. Installed by
# deploy/guest/ci-runners.sh, as root, once the L159b (install.sh) and L159g
# (install-pilot.sh) stack is in place.
#
# The unit is deliberately NOT installed by the runner's own `svc.sh`: its
# units are named `actions.runner.<org>-<repo>.<name>.service`, the pattern
# the guard counts as the APPLICATION's activity (`busy_units`). A guest
# runner must never count as the application, nor ever be stopped by a
# cleanup aimed at `actions.runner.*`.
#
# Single-use (option A of the R2 B1 arbitration): the unit is armed by
# ci-runners.sh --enable, and its ExecStart consumes **one** just-in-time
# configuration deposited by the ameesh side (`--spool`,
# `/srv/ameesh-guest/ci/jit/r%i`). The runner accepts that one job, then
# GitHub removes it: no registration token ever reaches this host, no durable
# credential stays on it, and `Restart=no` means nothing is re-armed behind
# the operator's back — the next job needs a fresh deposit and a fresh
# --enable (plan §3, §6).
#
# Gate (L159f, R1 #1256): the GitHub runner knows nothing of the guard's
# gate, so `ExecStart` is `/usr/local/lib/ameesh-guest-ci/ci-runner-gate` (installed
# by ci-runners.sh --prepare), not `run.sh` directly. It consumes a
# configuration and starts `run.sh` only while the state is a fresh
# `available` published by an enforcing guard, and stops the runner when the
# state closes, disappears or goes stale: a guest runner never outlives the
# guard that answers for it. A closed gate consumes nothing.
[Unit]
Description=ameesh GitHub Actions runner %i, single-use (guest on a lending host)
Documentation=https://github.com/manaty/ameesh/blob/main/deploy/guest/PILOT-ci-nexlink.md
After=network-online.target
Wants=network-online.target
# a volume in /etc/fstab that did not mount: no start on the root disk
RequiresMountsFor=/srv/ameesh-guest

[Service]
Type=simple
# one start = at most one job: the single-use configuration is spent, and a
# failure is not retried with someone else's registration
Restart=no
# The guest's own unprivileged user: no password, no sudo, no docker group
# (install.sh refuses it). Rootless Podman gives the jobs their containers.
User=ameesh-guest
Slice=ameesh-guest.slice
# Rootless Podman creates the containers' cgroups under this unit's cgroup,
# inside the guest's slice: the slice's CPU/memory caps cover the containers
# too, and stopping the slice kills them with the runner.
Delegate=yes
WorkingDirectory=/srv/ameesh-guest/ci/r%i
Environment=HOME=/srv/ameesh-guest/home
# /usr/local/lib/ameesh-guest-ci holds the `docker` shim that the runner and its
# service containers use (rootless Podman, never /run/docker.sock)
Environment=PATH=/usr/local/lib/ameesh-guest-ci:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AMEESH_GUEST=ci
# gate (study §1.5): the state document the wrapper reads; read-only for the
# guest, written by the root guard
Environment=AMEESH_HOST_GATE_PATH=/run/ameesh-gate/state/state.json
ExecStart=/usr/local/lib/ameesh-guest-ci/ci-runner-gate --dir /srv/ameesh-guest/ci/r%i --spool /srv/ameesh-guest/ci/jit/r%i
# a job the guard or the operator stops gets its SIGTERM first: the wrapper
# forwards it to the runner's process group, the listener passes it to
# Runner.Worker and the job ends
TimeoutStopSec=180
KillMode=mixed
# under a whole-host OOM the guest goes before the application
OOMScoreAdjust=500
TasksMax=4096
# Light hardening only: rootless Podman needs newuidmap (a setuid helper),
# /dev/fuse and its own sysctls in the container namespaces, so the strict
# profile of the agent unit (NoNewPrivileges, PrivateDevices, ProtectSystem)
# would break it. The isolation of the guest rests on the user, the slice and
# the rootless containers, not on these keys.
PrivateTmp=yes
