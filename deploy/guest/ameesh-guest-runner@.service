# SPDX-License-Identifier: AGPL-3.0-only
#
# ameesh — runner of agent %i as a GUEST of a lending host, mode (a1) (study
# L159 §2.1 and §3, lot L159g). A SYSTEM unit, so that the ceilings do not
# depend on cgroup delegation to a user manager.
#
# * identity: the dedicated user `ameesh-guest` (no sudo, no group of the
#   application, no `docker`), home and work on its own volume
#   /srv/ameesh-guest (0700);
# * ceilings: `ameesh-guest.slice` for the whole guest, `MemoryHigh` and
#   `MemoryMax` per agent here, `OOMScoreAdjust=500` (the global OOM picks
#   the guest first);
# * gate: the guard writes the state, the runner obeys it; an unreadable,
#   absent or stale state is `stopped` (L159f);
# * secrets: /etc/ameesh/guest.env (the host's login role, L56) and
#   /etc/ameesh/guest-%i.env (the agent's), 0640 root:ameesh-guest.
#
# Installed and enabled by the owner, as root (an agent never changes the
# units of a host):
#
#   install -m 0644 ameesh-guest-runner@.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ameesh-guest-runner@<agent>
#
# A different ceiling for one agent goes in
# /etc/systemd/system/ameesh-guest-runner@<agent>.service.d/.

[Unit]
Description=ameesh — guest runner of agent %i
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
# its volume, if /etc/fstab mounts one there: never the root disk instead
RequiresMountsFor=/srv/ameesh-guest

[Service]
User=ameesh-guest
Group=ameesh-guest
Slice=ameesh-guest.slice
WorkingDirectory=/srv/ameesh-guest
Environment=HOME=/srv/ameesh-guest/home
Environment=TMPDIR=/srv/ameesh-guest/tmp
Environment=PATH=/srv/ameesh-guest/home/.local/share/mise/shims:/srv/ameesh-guest/home/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/ameesh/guest.env
EnvironmentFile=-/etc/ameesh/guest-%i.env
# git's traces keep their redaction (a GIT_TRACE_REDACT=0 from the files
# above dropped: systemd applies it last), the credential helper's token
# included (mesh-design #457 r5)
UnsetEnvironment=GIT_TRACE_REDACT
# gate (study §1.5): read-only state, writable acknowledgement
Environment=AMEESH_HOST_GATE=file
Environment=AMEESH_HOST_GATE_PATH=/run/ameesh-gate/state/state.json
Environment=AMEESH_HOST_GATE_ACK=/run/ameesh-gate/ack/ack.json
Environment=AMEESH_HOST_GATE_FALLBACK=stopped
# a lent host is taken back fast: the turn stops at a safe point
Environment=AMEESH_DRAIN_SECONDS=120
ExecStart=/opt/ameesh/venv/bin/ameesh run --agents %i --runner-id guest-%i@%H
Restart=on-failure
RestartSec=30
KillMode=mixed
TimeoutStopSec=180
MemoryHigh=4G
MemoryMax=4.5G
OOMScoreAdjust=500
# hardening (study §3)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/ameesh-guest /run/ameesh-gate/ack
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock

[Install]
WantedBy=multi-user.target
