{
  "schema": "ameesh-staging-migrations/1",
  "rules": {
    "additive": [
      {
        "pattern": "(?:begin|commit)",
        "reason": "transaction"
      },
      {
        "pattern": "set local (?:search_path|lock_timeout)\\s*=.*",
        "reason": "settings"
      },
      {
        "pattern": "create table (?:if not exists )?[\\w.\\\"]+\\s*\\([^;]*\\)",
        "reason": "new table"
      },
      {
        "pattern": "create (?:unique )?index (?:concurrently )?(?:if not exists )?[\\w.\\\"]+ on [^;]+",
        "reason": "new index"
      },
      {
        "pattern": "alter table [\\w.\\\"]+ add column (?:if not exists )?[\\w\\\"]+ [^;]+",
        "reason": "new column"
      },
      {
        "pattern": "comment on [^;]+ is\\s*",
        "reason": "documentation"
      }
    ],
    "relaxation": [
      {
        "pattern": "alter table [^;]*\\bdrop constraint (?:if exists )?[\\w\\\"]+",
        "reason": "constraint removed"
      },
      {
        "pattern": "create or replace (?:function|procedure)\\s+[^;]+",
        "reason": "routine replaced"
      },
      {
        "pattern": "create or replace (?:trigger|rule|view)\\s+[^;]+",
        "reason": "guard or view replaced"
      }
    ],
    "destructive": [
      {
        "pattern": "drop (?:table|schema|type|view|function|procedure|trigger|policy)\\s+[^;]+",
        "reason": "object removed"
      },
      {
        "pattern": "alter table [^;]*\\bdrop column\\b[^;]*",
        "reason": "column removed"
      },
      {
        "pattern": "revoke\\s+[^;]+",
        "reason": "privilege removed"
      },
      {
        "pattern": "alter type\\s+[^;]+",
        "reason": "type changed"
      },
      {
        "pattern": "(?:delete from|update|truncate)\\s+[^;]+",
        "reason": "data changed"
      },
      {
        "pattern": "alter table [^;]*\\bset not null\\b[^;]*",
        "reason": "column mandatory"
      },
      {
        "pattern": "alter table [^;]*\\badd (?:constraint|primary key|foreign key|unique|check)\\b[^;]*",
        "reason": "constraint added"
      },
      {
        "pattern": "alter table [^;]*\\balter column\\b[^;]*\\btype\\b[^;]*",
        "reason": "column type changed"
      },
      {
        "pattern": "alter table [^;]*\\badd column\\b[^;]*\\bnot null\\b[^;]*",
        "reason": "mandatory column"
      }
    ]
  },
  "declarations": {}
}
