# Contexte de construction de l'image : seuls pyproject.toml, README.md,
# LICENSE et src/ sont copiés ; le reste est exclu, et surtout tout ce qui
# pourrait porter un secret ou un état local.
.git
.github
.venv
.claude
**/__pycache__
**/*.pyc
**/*.egg-info
build
dist
tests
docs
examples
scripts
deploy
bin
*.v0.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_*
**/.pgpass
**/config.json
# exceptions : le point d'entrée de l'image (L114), le binaire dsh épinglé
# déposé au contexte, et l'essai de bout en bout (L115, faux harnais)
!deploy/executor-image/ameesh-executor
!deploy/executor-image/dsh
!tests/fakebin/dsh
