     texte = json.dumps(carte, ensure_ascii=False, indent=1, sort_keys=True) + "\n"
     with gzip.open(chemin, "wt", encoding="utf-8") as f:
@@ -492,6 +532,9 @@ def main(argv: list[str] | None = None) -> int:
