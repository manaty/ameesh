   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "stopped"
  },
  {
   "why": "expires_ts as text: stopped",
   "doc": {
    "schema": "ameesh-host-state/1",
    "state": "available",
    "seq": 7,
    "expires_ts": "1791640090"
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "stopped"
