   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "stopped"
  },
  {
   "why": "expires_ts exactly 300 s ahead is admitted",
   "doc": {
    "schema": "ameesh-host-state/1",
    "state": "available",
    "seq": 7,
    "expires_ts": 1791640300.0
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "available"
  },
  {
