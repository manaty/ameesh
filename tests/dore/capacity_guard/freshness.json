    "schema": "ameesh-host-state/1",
    "state": "available",
    "seq": 7,
    "expires_ts": 1791640090.0
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "available"
  },
  {
   "why": "draining, fresh",
   "doc": {
    "schema": "ameesh-host-state/1",
    "state": "draining",
    "seq": 7,
    "expires_ts": 1791640060.0
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "draining"
  },
  {
   "why": "expired: the guard died, its available does not outlive it",
   "doc": {
    "schema": "ameesh-host-state/1",
    "state": "available",
    "seq": 7,
    "expires_ts": 1791639999.0
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "stopped"
  },
  {
   "why": "expiring exactly now is expired",
   "doc": {
    "schema": "ameesh-host-state/1",
    "state": "available",
    "seq": 7,
    "expires_ts": 1791640000.0
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "stopped"
  },
  {
   "why": "no expires_ts on a lending host: stopped",
   "doc": {
    "schema": "ameesh-host-state/1",
    "state": "available",
    "seq": 7
   },
   "now": 1791640000.0,
   "lending": true,
   "expect": "stopped"
  },
  {
