{
  "description": "L159e golden cases: a sequence of signals (t in seconds) and the level the guard decides at each step. Signals: mem_available_bytes, psi_* in %, busy, app_disk_free_bytes. Offer as in study L159 section 1.3.",
  "offer": {
    "cpu_max": 3, "memory_max": "14GiB", "agent_memory_max": "4.5GiB",
    "reclaim": {"memory_available_min": "6GiB", "cpu_pressure_max": "20%",
                "memory_pressure_max": "2%", "io_pressure_max": "20%",
                "busy_units": ["actions.runner.*"], "busy_max": 4},
    "drain_seconds": 90, "calm_seconds": 600
  },
  "calm": {"mem_available_bytes": 17179869184, "psi_cpu_10": 1, "psi_cpu_60": 1,
           "psi_mem_60": 0, "psi_io_10": 0, "psi_io_60": 0, "busy": 0,
           "app_disk_free_bytes": 53687091200},
  "cases": [
    {"name": "calm host lends", "steps": [
      {"t": 0, "level": 0, "reason": "idle", "state": "available"}]},
    {"name": "memory getting low reduces, then drains, then comes back after calm", "steps": [
      {"t": 0, "level": 0},
      {"t": 5, "signals": {"mem_available_bytes": 10737418240}, "level": 1, "reason": "app_memory"},
      {"t": 10, "signals": {"mem_available_bytes": 5368709120}, "level": 3, "reason": "app_memory", "state": "draining"},
      {"t": 15, "drained": true, "level": 3},
      {"t": 614, "drained": true, "level": 3},
      {"t": 615, "drained": true, "level": 0, "state": "available"}]},
    {"name": "memory pressure never freezes", "steps": [
      {"t": 0, "signals": {"psi_mem_60": 3}, "level": 3, "reason": "app_memory"}]},
    {"name": "cpu burst freezes, thaws to reduced, then calms", "steps": [
      {"t": 0, "level": 0},
      {"t": 5, "signals": {"psi_cpu_10": 35}, "level": 2, "reason": "app_cpu"},
      {"t": 10, "level": 1},
      {"t": 609, "level": 1},
      {"t": 610, "level": 0}]},
    {"name": "a freeze lasts 60 s at most, then drains", "steps": [
      {"t": 0, "signals": {"psi_io_10": 50}, "level": 2},
      {"t": 30, "signals": {"psi_io_10": 50}, "level": 2},
      {"t": 60, "signals": {"psi_io_10": 50}, "level": 3, "state": "draining"}]},
    {"name": "decided cpu pressure drains", "steps": [
      {"t": 0, "signals": {"psi_cpu_60": 25, "psi_cpu_10": 25}, "level": 3, "reason": "app_cpu"}]},
    {"name": "ci jobs: at max reduces, beyond drains", "steps": [
      {"t": 0, "signals": {"busy": 4}, "level": 1, "reason": "app_busy"},
      {"t": 5, "signals": {"busy": 5}, "level": 3, "reason": "app_busy"}]},
    {"name": "drain without acknowledgement stops 30 s after the deadline", "steps": [
      {"t": 0, "signals": {"mem_available_bytes": 1073741824}, "level": 3},
      {"t": 119, "signals": {"mem_available_bytes": 1073741824}, "level": 3},
      {"t": 120, "signals": {"mem_available_bytes": 1073741824}, "level": 4, "state": "stopped"}]},
    {"name": "drained guest is not stopped", "steps": [
      {"t": 0, "signals": {"mem_available_bytes": 1073741824}, "level": 3},
      {"t": 130, "signals": {"mem_available_bytes": 1073741824}, "drained": true, "level": 3}]},
    {"name": "low application disk drains", "steps": [
      {"t": 0, "signals": {"app_disk_free_bytes": 1073741824}, "level": 3, "reason": "disk_low"}]},
    {"name": "unreadable memory is not calm", "steps": [
      {"t": 0, "signals": {"mem_available_bytes": null}, "level": 3, "reason": "app_memory"}]},
    {"name": "unreadable pressure is ignored, not a breach", "steps": [
      {"t": 0, "signals": {"psi_cpu_10": null, "psi_cpu_60": null, "psi_io_10": null,
                           "psi_io_60": null, "psi_mem_60": null}, "level": 0}]}
  ]
}
