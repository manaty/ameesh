"""Faux harnais "codex" du banc de test — n'appelle jamais Codex CLI."""
import json
import os
import signal
import sys
import time


def _compte() -> dict:
    """Le compte vu par le harnais (L30) : dossiers, et l'EMPREINTE de la clé
    (jamais la clé, même factice)."""
    import hashlib
    cle = os.environ.get("DEEPSEEK_API_KEY")
    return {
        "CLAUDE_CONFIG_DIR": os.environ.get("CLAUDE_CONFIG_DIR"),
        "CODEX_HOME": os.environ.get("CODEX_HOME"),
        "DSH_HOME": os.environ.get("DSH_HOME"),
        "cle": hashlib.sha256(cle.encode()).hexdigest()[:12] if cle else None,
    }


def main() -> int:
    args = sys.argv[1:]
    if args == ["--version"]:  # L120: read by the runner, not a turn
        print("codex-cli 9.9.9")
        return 0
    log = os.environ.get("AMEESH_TEST_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({
                "harness": "codex", "argv": args, "compte": _compte(),
                "env": {k: os.environ.get(k) for k in (
                    "AGENT_MAIL_NAME", "AMEESH_RUNNER_ID", "AGENT_MESH_RUNNER_ID",
                    "AMEESH_LEASE_EPOCH", "AGENT_MESH_LEASE_EPOCH",
                    "AMEESH_HOST", "AMEESH_SCHEMA")},
            }) + "\n")
    if os.environ.get("AMEESH_TEST_SLEEP"):
        time.sleep(float(os.environ["AMEESH_TEST_SLEEP"]))
    if os.environ.get("AMEESH_TEST_KILL_SELF"):
        os.kill(os.getpid(), signal.SIGKILL)
    thread = "codex-thread-1"
    if "resume" in args:
        thread = args[args.index("resume") + 1]
    # #5148 : un journal daté du tour (task_started dans la fenêtre observée),
    # pas de l'avant-tour. Le lecteur borne l'usage au tour ; un témoin qui
    # daterait le journal avant la création du worker serait dépendant du temps.
    journal = os.environ.get("AMEESH_TEST_CODEX_JOURNAL")
    if journal:
        last_usage = json.loads(
            os.environ.get("AMEESH_TEST_CODEX_LAST_USAGE") or "null") or {
                "input_tokens": 61000, "output_tokens": 500}
        dossier = os.path.join(journal, "2026", "10", "31")
        os.makedirs(dossier, exist_ok=True)
        path = os.path.join(dossier,
                            "rollout-2026-10-31T01-00-00-%s.jsonl" % thread)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(json.dumps({"type": "event_msg", "payload": {
                "type": "task_started", "started_at": int(time.time())}}) + "\n")
            fh.write(json.dumps({"type": "event_msg", "payload": {
                "type": "token_count",
                "info": {"last_token_usage": last_usage}}}) + "\n")
    demarrage = {"type": "thread.started", "thread_id": thread}
    # CTX-03b : le vrai `codex exec --json` n'annonce pas son modèle ; ce
    # réglage de banc permet de témoigner du cas où un harnais le fait.
    if os.environ.get("AMEESH_TEST_CODEX_MODEL"):
        demarrage["model"] = os.environ["AMEESH_TEST_CODEX_MODEL"]
    print(json.dumps(demarrage), flush=True)
    # #3779 : un tour refusé par le fournisseur (429), comme le vrai CLI.
    failed = os.environ.get("AMEESH_TEST_TURN_FAILED")
    if failed:
        print(json.dumps({"type": "turn.failed",
                          "error": {"message": failed}}), flush=True)
        return 1
    # L218 : AMEESH_TEST_MESSAGES, liste JSON des messages de l'agent du tour
    messages = json.loads(os.environ.get("AMEESH_TEST_MESSAGES") or "null")
    for texte in messages if messages is not None else [
            "bonjour du faux codex (fil %s)" % thread]:
        print(json.dumps({"type": "item.completed", "item": {
            "type": "agent_message", "text": texte}}), flush=True)
    # #2932 : AMEESH_TEST_CODEX_USAGE, usage JSON de fin de tour (cumulé)
    usage = json.loads(os.environ.get("AMEESH_TEST_CODEX_USAGE") or "null") or {
        "input_tokens": 10, "output_tokens": 5}
    print(json.dumps({"type": "turn.completed", "usage": usage}), flush=True)
    return int(os.environ.get("AMEESH_TEST_EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main())
