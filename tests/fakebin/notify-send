"""Faux backend de bureau du banc de test (L38, L66) — n'affiche jamais rien.

Sous Linux, c'est le `notify-send` du PATH (ou de `AMEESH_NOTIFY_SEND_BIN`) ;
sous macOS, le banc le pose en `AMEESH_OSASCRIPT_BIN` (#3131) : il reçoit
alors `-e <script AppleScript>` et le journalise tel quel.

Journalise son argv (une ligne JSON) dans `AMEESH_FAKE_NOTIFY_LOG` ;
`AMEESH_FAKE_NOTIFY_EXIT` règle le code de sortie (défaut 0), avec un message
sur stderr quand il n'est pas nul.
"""
import json
import os
import sys

log = os.environ.get("AMEESH_FAKE_NOTIFY_LOG")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(sys.argv[1:], ensure_ascii=False) + "\n")
code = int(os.environ.get("AMEESH_FAKE_NOTIFY_EXIT") or 0)
if code:
    print("faux backend de bureau : pas de bus de session", file=sys.stderr)
sys.exit(code)
