+def protected_read_probe():
+    """B3 (#200943) : fixture root 0600 dans un dossier root 0711 que le démon rootless (uid 1001) peut
+    traverser pour le montage. Le conteneur doit DÉMARRER et cat doit échouer sur « Permission denied »
+    (root du conteneur = uid mappé, sans droit sur le fichier) ; une erreur de montage ou de démarrage
+    n'est pas une preuve : KO. Dossier et fixture retirés ensuite."""
+    assert not FIXTURE_DIR.exists(), 'dossier de fixture déjà présent : réconcilier'
+    FIXTURE_DIR.mkdir(mode=0o711)
+    os.chmod(FIXTURE_DIR, 0o711)
+    fixture = FIXTURE_DIR / 'protected'
+    try:
+        fd = os.open(fixture, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        with os.fdopen(fd, 'wb') as out:
+            out.write(b'fixture operateur 6321\n')
+        probe = docker(RL, 'run', '--rm', '--network=none', '--label=ameesh.operator=6321',
+                       '--mount', 'type=bind,src=' + str(fixture) + ',dst=/protected,readonly',
+                       '--entrypoint=/bin/cat', IMAGES['postgres:17'], '/protected', allow_error=True)
+        err = probe.stderr.decode(errors='replace')
+        assert not probe.stdout, 'Conteneur rootless a LU un fichier root 0600'
+        assert probe.returncode == 1 and 'Permission denied' in err, 'Pas de refus de lecture prouvé (rc %d)' % probe.returncode
+        assert not any(x in err for x in ('error mounting', 'OCI runtime', 'invalid mount', 'no such file or directory', 'Error response from daemon')), \
+            'Erreur de montage ou de démarrage : ce n est pas un refus de lecture'
+    finally:
+        if fixture.exists():
+            fixture.unlink()
+        FIXTURE_DIR.rmdir()
+
