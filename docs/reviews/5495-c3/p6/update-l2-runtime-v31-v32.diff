+def clear_stale(tmp, owner_uid):
+    """Retire le SEUL temporaire de l'installateur laissé par un échec antérieur (nom exact
+    <cible>.p6.tmp). Refus nommé, sans rien toucher, s'il n'est pas un fichier régulier non lié de
+    owner_uid ; la commande d'examen est donnée. Retourne True si un résidu a été retiré."""
+    tmp = Path(tmp)
+    assert tmp.name.endswith('.p6.tmp')
+    try:
+        st = tmp.lstat()
+    except FileNotFoundError:
+        return False
+    if not (stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_uid == owner_uid):
+        raise AssertionError('stale %s is not the installer temporary (regular, nlink 1, uid %d): '
+                             'inspect with « stat %s » and remove it by hand if it is ours' % (tmp, owner_uid, tmp))
+    os.unlink(tmp)
+    return True
