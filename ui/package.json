{
  "name": "@ameesh/ui",
  "version": "0.0.0",
  "description": "Embeddable web components of an ameesh mesh (L88/L92, docs/design/etudes/ui-integrable.md)",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen-api.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/dist.mjs",
    "prepack": "node scripts/dist.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/build.mjs --out .test-build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manaty/ameesh.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/manaty/ameesh/tree/main/ui",
  "bugs": {
    "url": "https://github.com/manaty/ameesh/issues"
  },
  "keywords": [
    "ameesh",
    "mesh",
    "agents",
    "web-components",
    "lit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
